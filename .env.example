# Copy to .env or .netlify/.env for local development (do not commit real keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...paste_anon_public_key_from_supabase_api_settings

# Optional — used by Netlify functions, not the browser
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used for appointment and demo used-tire receipt emails
RESEND_API_KEY=
EMAIL_FROM=EastCord Tires <info@eastcordtires.ca>
# Optional — improves Google Drive photo loading in used tire cards
GOOGLE_API_KEY=

# Google Sheets → usedtireinventory sync (server-side only)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A:Z
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste as one line with literal \n between private-key lines
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Local-only alternative to the two service-account values above
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=.netlify/google-service-account.json
INVENTORY_SYNC_SECRET=
# Keep false until you intentionally want rows removed from the sheet set to stock 0
SYNC_DEACTIVATE_MISSING=false
